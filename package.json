{
  "name": "carequeue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck && tsc --noEmit",
    "lint": "eslint .",
    "test": "pnpm --filter @carequeue/api test",
    "test:integration": "pnpm --filter @carequeue/api test:integration",
    "start": "pnpm --filter @carequeue/api start",
    "publisher": "pnpm --filter @carequeue/api publisher",
    "worker": "pnpm --filter @carequeue/api worker",
    "migrate": "pnpm --filter @carequeue/api migrate",
    "format": "prettier --write apps tests *.ts *.json *.js *.yaml README.md .github/workflows/*.yml",
    "dev:frontend": "pnpm --filter @carequeue/web dev",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0"
  }
}
