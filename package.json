{
  "name": "carequeue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc && vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc -p frontend/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/integration.test.ts --exclude tests/*.integration.test.ts",
    "test:integration": "vitest run integration",
    "start": "node dist/src/api.js",
    "publisher": "node dist/src/publisher.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "format": "prettier --write src tests frontend *.ts *.json *.js *.yaml README.md .github/workflows/*.yml",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
