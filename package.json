{
  "name": "carequeue",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude tests/integration.test.ts --exclude tests/*.integration.test.ts",
    "test:integration": "vitest run tests/integration.test.ts tests/*.integration.test.ts",
    "start": "node dist/src/api.js",
    "publisher": "node dist/src/publisher.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js",
    "format": "prettier --write src tests *.json *.js *.yaml README.md .github/workflows/*.yml"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.19.0"
}
