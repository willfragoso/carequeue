{
  "name": "@carequeue/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "files": [
    "dist/src",
    "migrations"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration.test.ts --exclude tests/*.integration.test.ts",
    "test:integration": "vitest run integration",
    "start": "node dist/src/api.js",
    "publisher": "node dist/src/publisher.js",
    "worker": "node dist/src/worker.js",
    "migrate": "node dist/src/migrate.js"
  },
  "dependencies": {
    "amqplib": "^2.2.0",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "pino": "^10.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
